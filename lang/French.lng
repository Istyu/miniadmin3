; ---- Types de jeu : description des variables intégrées
gtvar.scorelimit=Limite de score (0 = aucune)
gtvar.timelimit=Limite de temps en minutes (0 = aucune)
gtvar.numlives=Nombre de vies (0 = illimité)
gtvar.roundlimit=Nombre de manches
gtvar.winlimit=Manches gagnées nécessaires pour remporter le match
gtvar.roundswitch=Changement de camp toutes les N manches
gtvar.playerrespawndelay=Délai de réapparition en secondes
gtvar.waverespawndelay=Réapparition par vagues : tout le monde réapparaît ensemble toutes les N secondes (0 = désactivé)
gtvar.bombtimer=Minuterie de la bombe en secondes
gtvar.planttime=Temps de pose de la bombe en secondes
gtvar.defusetime=Temps de désamorçage de la bombe en secondes
gtvar.multibomb=Chaque attaquant porte une bombe (1 = oui)
gtvar.hotpotato=Minuterie commune : le temps restant est conservé après un désamorçage (1 = oui)
gtvar.flagcapturetime=Temps de capture d'un drapeau en secondes
gtvar.roundlength=Durée d'une manche en minutes
gtvar.graceperiod=Délai de grâce au début de la manche en secondes (on peut encore rejoindre)
gtvar.respawn_wave_time=Réapparition par vagues : tout le monde réapparaît ensemble toutes les N secondes
gtvar.alivepointtime=Un joueur en vie marque un point toutes les N secondes
gtvar.showcarrier=Le porteur de l'objectif est affiché sur la boussole (1 = oui)
gtvar.startrounddelay=Délai avant le début d'une manche en secondes
gtvar.endrounddelay=Délai après la fin d'une manche en secondes
gtvar.clearscoreeachround=Remise à zéro des scores au début de chaque manche (1 = oui)
gtvar.globalbattlechatterprobability=Fréquence des cris de combat (battle chatter)
gtvar.enemycarriervisible=Le porteur du drapeau ennemi est affiché sur la boussole
gtvar.flagrespawntime=Délai avant la réapparition du drapeau en secondes
gtvar.idleflagreturntime=Un drapeau lâché retourne à sa base après N secondes
gtvar.touchreturn=Toucher son drapeau lâché le ramène à la base (1 = oui)
gtvar.showoncompass=Les drapeaux sont affichés sur la boussole (1 = oui)
gtvar.koth_autodestroytime=Le QG se détruit tout seul après N secondes
gtvar.koth_spawntime=Délai avant l'apparition d'un nouveau QG en secondes
gtvar.koth_kothmode=Mode King of the Hill classique (0 = désactivé, 1 = activé)
gtvar.koth_capturetime=Temps de capture du QG en secondes
gtvar.koth_destroytime=Temps de destruction du QG en secondes
gtvar.koth_delayplayer=L'équipe qui tient le QG réapparaît avec un délai (0 = désactivé, 1 = activé)
gtvar.koth_spawndelay=Délai de réapparition en secondes de l'équipe qui tient le QG (si koth_delayPlayer = 1)
gtvar.twar_capturetime=Temps de capture d'un drapeau en secondes
gtvar.twar_finalfighttimelimit=Limite de temps du combat final
gtvar.twar_showenemycount=Afficher le nombre d'ennemis (0 = désactivé, 1 = activé)
gtvar.twar_momentumenabled=Système de momentum activé ou non (0 = désactivé, 1 = activé)
gtvar.twar_momentummax=Valeur maximale du momentum

