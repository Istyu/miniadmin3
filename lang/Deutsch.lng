qc.help=Mapwechsel:\n[Mapwechsel-Kürzel] → Map-Alias → [ENTER] → die Map wechselt\n\nMapwechsel abbrechen:\n[Mapwechsel-Kürzel] → falscher Map-Alias → [BACKSPACE] → Befehl abgebrochen\n\nSpieltyp ändern:\n[Spieltyp-Kürzel] → tdm → [ENTER] → tdm wird geladen\n\nDie Befehle gehen an den ausgewählten Server; die Kürzel funktionieren auch im Spiel.
qc.saved=Tastenkürzel gespeichert.
qc.saveFailed=Die Tastenkürzel konnten nicht gespeichert werden (shortcutctrl.cfg / mapaliases.dat).
qc.registerFailed=Dieses Tastenkürzel konnte nicht registriert werden: %1
qc.noServer=Tastenkürzel: wähle einen Server mit RCON-Passwort.
qc.typeMap=Tastenkürzel: Map-Alias eintippen, dann Enter (Backspace: abbrechen).
qc.typeGametype=Tastenkürzel: Spieltyp eintippen (z. B. tdm), dann Enter (Backspace: abbrechen).
qc.cancelled=Tastenkürzel: abgebrochen.
qc.unknownAlias=Tastenkürzel: unbekannter Map-Alias: %1
qc.badGametype=Tastenkürzel: ungültiger Spieltyp: %1
qc.killed=COD beendet (%1 Prozess).
qc.noCod=COD läuft nicht.
