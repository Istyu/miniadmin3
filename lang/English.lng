; ---- Gametypes: descriptions of the built-in variables
gtvar.scorelimit=Score limit (0 = none)
gtvar.timelimit=Time limit in minutes (0 = none)
gtvar.numlives=Number of lives (0 = unlimited)
gtvar.roundlimit=Number of rounds
gtvar.winlimit=Round wins needed to win the match
gtvar.roundswitch=Switch sides every this many rounds
gtvar.playerrespawndelay=Respawn delay in seconds
gtvar.waverespawndelay=Wave respawn: everyone respawns together every this many seconds (0 = off)
gtvar.bombtimer=Bomb timer in seconds
gtvar.planttime=Time to plant the bomb in seconds
gtvar.defusetime=Time to defuse the bomb in seconds
gtvar.multibomb=Every attacker carries a bomb (1 = yes)
gtvar.hotpotato=Shared bomb timer: the remaining time is kept after a defuse (1 = yes)
gtvar.flagcapturetime=Time to capture a flag in seconds
gtvar.roundlength=Round length in minutes
gtvar.graceperiod=Grace period at the start of a round in seconds (players can still join)
gtvar.respawn_wave_time=Wave respawn: everyone respawns together every this many seconds
gtvar.alivepointtime=A living player scores a point every this many seconds
gtvar.showcarrier=The objective carrier is shown on the compass (1 = yes)
gtvar.startrounddelay=Delay before a round starts in seconds
gtvar.endrounddelay=Delay after a round ends in seconds
gtvar.clearscoreeachround=Reset the scores at the start of every round (1 = yes)
gtvar.globalbattlechatterprobability=How often battle chatter is heard
gtvar.enemycarriervisible=The enemy flag carrier is shown on the compass
gtvar.flagrespawntime=Time until the flag reappears in seconds
gtvar.idleflagreturntime=A dropped flag returns to its base after this many seconds
gtvar.touchreturn=Touching your dropped flag returns it (1 = yes)
gtvar.showoncompass=The flags are shown on the compass (1 = yes)
gtvar.koth_autodestroytime=The HQ destroys itself after this many seconds
gtvar.koth_spawntime=Time until a new HQ appears in seconds
gtvar.koth_kothmode=Classic King of the Hill mode (0 = off, 1 = on)
gtvar.koth_capturetime=Time to capture the HQ in seconds
gtvar.koth_destroytime=Time to destroy the HQ in seconds
gtvar.koth_delayplayer=The team holding the HQ respawns with a delay (0 = off, 1 = on)
gtvar.koth_spawndelay=Respawn delay in seconds for the team holding the HQ (if koth_delayPlayer = 1)
gtvar.twar_capturetime=Time to capture a flag in seconds
gtvar.twar_finalfighttimelimit=Time limit of the final fight
gtvar.twar_showenemycount=Show the number of enemies (0 = off, 1 = on)
gtvar.twar_momentumenabled=Momentum system on or off (0 = off, 1 = on)
gtvar.twar_momentummax=Maximum momentum value

